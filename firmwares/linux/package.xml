<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lucy_embedded_firmware_linux</name>
  <version>0.1.0</version>
  <description>Linux firmware driving Feetech servos over a USB-serial adapter from the ros2_control shared memory.</description>
  <maintainer email="contact@lucy-robotics.com">Lucy Robotics Team</maintainer>
  <license>GPL-3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>pkg-config</build_depend>
  <depend>libudev-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
